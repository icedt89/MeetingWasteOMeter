{
  "name": "meeting-waste-o-meter",
  "author": "Jan Hafner",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "format": "prettier --write .",
    "generate-pwa-assets": "pwa-assets-generator",
    "all": "npm run test:run && npm run format && npm run generate-pwa-assets && npm run build"
  },
  "dependencies": {
    "@date-fns/utc": "^2.1.1",
    "@vueuse/core": "^13.6.0",
    "date-fns": "^4.1.0",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.4.1",
    "vue": "^3.5.18",
    "vuetify": "^3.9.4"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^24.2.1",
    "@vite-pwa/assets-generator": "^1.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.7.0",
    "prettier": "^3.6.2",
    "sass": "1.90.0",
    "sass-embedded": "^1.90.0",
    "typescript": "~5.9.2",
    "unplugin-fonts": "^1.4.0",
    "unplugin-vue-components": "^29.0.0",
    "vite": "^7.1.1",
    "vite-plugin-pwa": "^1.0.2",
    "vite-plugin-vuetify": "^2.1.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.5"
  }
}
